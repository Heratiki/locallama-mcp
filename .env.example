# Server Configuration: These settings configure the server's basic networking.
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api

# Local LLM Endpoints: These settings configure the endpoints for local Large Language Models.
LM_STUDIO_ENDPOINT=http://localhost:1234/v1
OLLAMA_ENDPOINT=http://localhost:11434/api
OLLAMA_TIMEOUT=120
PROVIDER_MAX_CONCURRENT_LOCAL=2
PROVIDER_MAX_CONCURRENT_REMOTE=5

# Model Configuration: These settings configure the behavior of the language model.
DEFAULT_LOCAL_MODEL=llama2
MODEL_TEMPERATURE=0.1
MODEL_MAX_TOKENS=2048
MODEL_TOP_P=0.95
MODEL_FREQUENCY_PENALTY=0
MODEL_PRESENCE_PENALTY=0

# Decision Thresholds: These settings determine when to split tasks, control costs, and ensure quality.
TOKEN_THRESHOLD=1000
COST_THRESHOLD=0.02
QUALITY_THRESHOLD=0.7
PROVIDER_HEALTH_PROBE_INTERVAL_MS=60000

# API Keys: These settings configure API keys for external services.
OPENROUTER_API_KEY=

# Benchmark Configuration: These settings control how benchmarks are run.
BENCHMARK_RUNS_PER_TASK=3
BENCHMARK_PARALLEL=false
BENCHMARK_MAX_PARALLEL_TASKS=2
BENCHMARK_TASK_TIMEOUT=60000
BENCHMARK_SAVE_RESULTS=true
BENCHMARK_RESULTS_PATH=./benchmark-results
RELIABLE_BENCHMARK_COUNT=3
MIN_VALIDATOR_SCORE=0.6
VALIDATION_RETRY_BUDGET=1
# STARTUP_BENCHMARK_TARGETS: Comma-separated list of model types to benchmark on startup.
# Options: local, free, paid, all, none. Default depends on OPENROUTER_API_KEY (free if set, local otherwise).
# Example: STARTUP_BENCHMARK_TARGETS=local,free
STARTUP_BENCHMARK_TARGETS=local,free

# Logging Configuration: These settings configure the logging behavior of the application.
LOG_LEVEL=info
LOG_FILE=

# Python Configuration: These settings configure the Python environment.
PYTHON_PATH=
PYTHON_VENV_PATH=
PYTHON_DETECT_VENV=true
RETRIV_PYTHON_PATH=

# Code Search Configuration: These settings configure the semantic code search functionality.
CODE_SEARCH_ENABLED=true
CODE_SEARCH_EXCLUDE_PATTERNS=["node_modules/**","dist/**",".git/**"]
CODE_SEARCH_INDEX_ON_START=true
CODE_SEARCH_REINDEX_INTERVAL=3600

# Cache Settings: These settings configure the response caching mechanism.
CACHE_ENABLED=true
CACHE_DIR=./.cache
MAX_CACHE_SIZE=1073741824

# Enable patch_task explicitly (default off).
PATCH_TASKS_ENABLED=false
# Allowed repository roots, separated by : on POSIX or ; on Windows; empty permits none.
PATCH_REPO_ROOTS=
# Keep failed scratch workspaces for debugging (default false).
PATCH_KEEP_WORKSPACE_ON_FAIL=false
# Scratch directory, relative to config.rootDir unless absolute (default config.rootDir/scratch/).
SCRATCH_DIR=./scratch
# Maximum local models in the patch ladder.
PATCH_LOCAL_MODELS=2
# Maximum free models in the patch ladder.
PATCH_FREE_MODELS=2
# Maximum paid models, eligible only with request allow_paid and OPENROUTER_FREE_ONLY=false.
PATCH_PAID_MODELS=1
# Maximum attempts before advancing to the next model.
PATCH_ATTEMPTS_PER_MODEL=3
# Total attempt budget across the patch ladder.
PATCH_MAX_ATTEMPTS=12
# Per-task deadline in milliseconds (2 hours).
PATCH_TASK_TIMEOUT_MS=7200000
# Maximum output tokens per patch inference call.
PATCH_MAX_OUTPUT_TOKENS=2000
# Context token cap for patch prompts.
PATCH_CONTEXT_TOKENS=6000
# Maximum concurrent patch workers (hardware-floor default 1).
PATCH_MAX_CONCURRENT=1
# Per-inference timeout in milliseconds (15 minutes).
PATCH_INFERENCE_TIMEOUT_MS=900000
# Default check timeout in milliseconds (10 minutes).
PATCH_CHECK_TIMEOUT_MS=600000
# Maximum error-tail tokens returned to the model.
PATCH_ERROR_TAIL_TOKENS=800
# Maximum file lines eligible for whole-file fallback.
PATCH_WHOLE_FILE_MAX_LINES=150
# Per-task paid cap in USD; paid calls still require explicit opt-in.
PATCH_PAID_CAP_USD=0.25
# Estimated frontier tokens saved per small-model token on accepted patch tasks
# (get_savings, goal G1). Must be a number > 0; invalid values fail at startup.
SAVINGS_TOKEN_FACTOR=1.0
